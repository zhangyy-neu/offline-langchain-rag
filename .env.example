# ============ 离线模型配置（复制本文件为 .env 后按需修改）============

# Ollama 服务地址（默认本地 11434 端口）
OLLAMA_BASE_URL=http://localhost:11434

# 对话大模型（需先执行: ollama pull qwen2.5:7b）
LLM_MODEL=qwen2.5:7b

# 向量化模型（需先执行: ollama pull qllama/bge-small-zh-v1.5）
EMBEDDING_MODEL=qllama/bge-small-zh-v1.5

# ============ 在线大模型配置（可选，用于在线推理模式）============
# DeepSeek API Key（在 https://platform.deepseek.com 申请，复制 .env.example 为 .env 后填写）
DEEPSEEK_API_KEY=
# DeepSeek 接口地址与模型（一般无需修改；OpenAI 兼容接口）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 文本切分参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 知识库目录（存放 TXT / PDF / Markdown 文件）
KNOWLEDGE_DIR=data/knowledge

# Chroma 向量数据库存储目录
CHROMA_DIR=data/chroma

# 检索返回的相关文档块数量
RETRIEVER_K=4
